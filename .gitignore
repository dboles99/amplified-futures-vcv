# Ignore all dotfiles except git dotfiles
.*
!.git*

# Binaries and build targets
*.a
*.so
*.dylib
*.dll
/build
/dep
/dist

# InsectSet32 sample bank (324 MB — download separately from Zenodo 7072196)
# The full InsectSet32 tree (670 files, 324 MB) stays out of the repo. The
# curated banks under it do not - git cannot re-include a path inside an
# excluded DIRECTORY, so the contents are excluded and banks/ re-added.
/res/insects/*
!/res/insects/banks/

# Python bytecode from tools/
__pycache__/
*.pyc

# WAV fixtures the reader suite synthesises at run time
/tests/t_*.wav
